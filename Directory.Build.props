<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.9.3</Version>
    <!-- docs/error-logging.md: stack traces carry src/...:line (embedded portable PDBs) and no build-machine path is in a binary. -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <RootNamespace>OptimizationTool.$(MSBuildProjectName.Replace('OptimizationTool.', ''))</RootNamespace>
  </PropertyGroup>
</Project>
