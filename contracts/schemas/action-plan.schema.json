{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.optimizationtool.invalid/v1/action-plan.schema.json",
  "title": "ActionPlan",
  "description": "Result of action.preview, action.get (adds operation), action.decline and action.undo (m4-actions §3). Approval binds planId + planHash + a single-use nonce.",
  "type": "object",
  "required": ["planId", "actionId", "handlerVersion", "label", "findingId", "reportId", "target", "before", "after", "rows", "context", "tradeoffs",
               "privilege", "undo", "requestedBy", "planHash", "createdAt", "expiresAt", "status", "ineligible"],
  "properties": {
    "planId": { "type": "string", "pattern": "^plan-[0-9a-f]{16}$" },
    "actionId": { "type": "string" },
    "handlerVersion": { "type": "string" },
    "label": { "type": "string", "description": "The handler's label, e.g. Change power plan." },
    "kind": { "enum": ["setting", "provider", "manual"] },
    "findingId": { "type": ["string", "null"], "pattern": "^fnd-" },
    "reportId": { "type": ["string", "null"], "pattern": "^report-" },
    "target": { "type": "object" },
    "before": { "type": "object" },
    "after": { "type": "object" },
    "parameters": { "type": ["object", "null"] },
    "rows": { "type": "array", "items": { "type": "object", "required": ["label", "before", "after"],
      "properties": { "label": { "type": "string" }, "before": { "type": "string" }, "after": { "type": "string" } } } },
    "context": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 } },
    "tradeoffs": { "type": "array", "items": { "type": "string" } },
    "privilege": { "enum": ["none", "admin"] },
    "undo": { "type": "object", "required": ["supported", "conditions"],
      "properties": { "supported": { "type": "boolean" }, "conditions": { "type": ["string", "null"] } } },
    "requestedBy": { "type": "object", "required": ["kind", "taskId", "invocationId"],
      "properties": { "kind": { "enum": ["user", "in_app", "claude_code", "codex"] }, "taskId": { "type": ["string", "null"] }, "invocationId": { "type": ["string", "null"] } } },
    "undoOf": { "type": ["string", "null"], "pattern": "^op-" },
    "planHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": { "$ref": "scan.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "scan.schema.json#/$defs/timestamp" },
    "status": { "enum": ["awaiting_user", "approved", "running", "verified", "failed", "indeterminate", "declined", "expired", "cancelled", "ineligible"] },
    "ineligible": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["code", "message"],
      "properties": { "code": { "type": ["string", "null"] }, "message": { "type": ["string", "null"] }, "manualUri": { "type": ["string", "null"] } } }] },
    "operation": { "oneOf": [{ "type": "null" }, { "$ref": "operation.schema.json" }] }
  }
}
