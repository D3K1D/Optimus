{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.optimizationtool.invalid/v1/research.schema.json",
  "title": "Researched reports",
  "description": "m9-ai-powers §6: research.get / research.start / research.cancel results (§6.5, with the §6.8 check-up), the applied label item (§6.2), the research.state event payload, the shell's shell.openSource result and the shell-only research.source result.",
  "$ref": "#/$defs/view",
  "$defs": {
    "status": { "enum": ["off", "queued", "running", "done", "partial", "cancelled", "failed", "unavailable"] },
    "runId": { "type": "string", "pattern": "^research-[0-9a-f]{16}$" },
    "sourceId": { "type": "string", "pattern": "^src-[0-9a-f]{8,32}$" },
    "view": {
      "type": "object",
      "required": ["runId", "status", "done", "total", "trial", "items", "usage", "checkup"],
      "additionalProperties": false,
      "properties": {
        "runId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runId" }], "description": "null when no run exists for the report." },
        "status": { "$ref": "#/$defs/status" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0, "maximum": 12 },
        "trial": { "type": "boolean", "description": "true while the first subject of a run that started with web \"unknown\" is in flight." },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" }, "description": "Labelled findings only, in report order." },
        "usage": {
          "type": "object",
          "required": ["searches", "inputTokens", "outputTokens"],
          "additionalProperties": false,
          "properties": {
            "searches": { "type": "integer", "minimum": 0 },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "checkup": { "$ref": "#/$defs/checkup" }
      }
    },
    "checkup": {
      "description": "§6.8 the broad check-up: off without do.web or an AI; unavailable when the provider cannot search; else the last check-up's outcome for this provider (idle when there is none or it was cancelled). cards: the report's check-up card IDs in deck order. done with cards [] is a distinct result (\"Checked online · nothing new found\"), never idle.",
      "type": "object",
      "required": ["status", "lastAt", "cards"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["off", "idle", "running", "done", "partial", "failed", "unavailable"] },
        "lastAt": { "oneOf": [{ "type": "null" }, { "$ref": "scan.schema.json#/$defs/timestamp" }], "description": "When the last check-up ended done or partial." },
        "cards": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^card-[0-9a-f]{16}$" } },
        "missed": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["hardware", "drivers", "windows", "programs", "background"] }, "description": "The areas NOT checked (the call failed or was not reached) when status is partial; empty (the host) or absent otherwise." }
      }
    },
    "checkupKind": { "enum": ["bug", "security", "end_of_life", "conflict", "update"] },
    "item": {
      "type": "object",
      "required": ["findingId", "verdict", "summary", "sources", "basis", "by", "researchedAt"],
      "additionalProperties": false,
      "properties": {
        "findingId": { "type": "string", "pattern": "^fnd-[0-9a-f]{16}$" },
        "verdict": { "enum": ["considered_safe", "worth_a_look"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400, "description": "Plain text; shown in the app; released to a chat task only with share.names (§6.2 rule 7)." },
        "sources": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/source" } },
        "basis": { "enum": ["name_and_publisher", "name_only"] },
        "by": {
          "type": "object",
          "required": ["kind", "label", "model"],
          "properties": {
            "kind": { "enum": ["anthropic_api", "openai_api", "chatgpt_plan", "claude_code_mcp", "codex_mcp"], "description": "codex_mcp: legacy, read only (results stored before M9 dropped the Codex provider)." },
            "label": { "type": "string" },
            "model": { "type": ["string", "null"] }
          }
        },
        "researchedAt": { "$ref": "scan.schema.json#/$defs/timestamp" }
      }
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "title", "domain"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "$ref": "#/$defs/sourceId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$", "description": "The host name in punycode." }
      }
    },
    "state": {
      "type": "object",
      "required": ["reportId", "runId", "status", "done", "total", "trial", "phase"],
      "additionalProperties": false,
      "properties": {
        "reportId": { "type": "string", "pattern": "^report-" },
        "runId": { "$ref": "#/$defs/runId" },
        "status": { "$ref": "#/$defs/status" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0, "maximum": 12 },
        "trial": { "type": "boolean" },
        "phase": { "enum": ["labels", "checkup"], "description": "§6.8: labels = the per-finding research, checkup = the broad check-up over the §6.10 inventory areas (total ≤ 5 areas; trial always false)." }
      }
    },
    "startParams": {
      "type": "object",
      "required": ["idempotencyKey", "reportId"],
      "properties": { "idempotencyKey": { "type": "string" }, "reportId": { "type": "string" } }
    },
    "openSourceResult": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": { "status": { "enum": ["opened", "unknown", "blocked"] } }
    },
    "sourceResult": {
      "description": "research.source (shell-only, never from the renderer): the stored URL after hygiene.",
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": { "url": { "type": "string", "pattern": "^https://", "maxLength": 300 } }
    }
  }
}
